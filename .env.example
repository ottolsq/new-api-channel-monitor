# channel-monitor/.env.example

# new-api 入口地址（含协议与端口）
API_BASE_URL=http://localhost:3000

# new-api dashboard 凭据（登录 /api/user/login 后获取 access_token）
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=

# 飞书自定义机器人 webhook URL（留空则不告警）
FEISHU_WEBHOOK_URL=

# SQLite 数据库路径（容器内推荐挂载到 /app/data/monitor.db）
DB_PATH=./monitor.db

# 检测周期（分钟）；建议 30 或 60，避免触发 new-api 登录限流
INTERVAL_MINUTES=30

# 失败重试次数；0 表示只测 1 次；建议 2（共 3 次）
RETRY_TIMES=2

# 重试间隔（秒）
RETRY_DELAY_SECONDS=30

# 单个模型测试超时（秒）
TIMEOUT_SECONDS=60

# 同一渠道同一模型在窗口内只告警 1 次（分钟）；0 表示不防抖
ALERT_DEBOUNCE_MINUTES=60
